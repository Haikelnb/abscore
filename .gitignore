# virtualenv and build
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# IEDB response cache. Not committed: it is a working cache that grows with use.
# The subset the test suite needs IS committed, under tests/data/iedb/, so the
# suite runs offline. See that directory's README.
cache/

# scratch
*.log
.DS_Store
**/.DS_Store

# Generated reports. `abscore score --save report.html` writes into the working
# directory, so these appear during ordinary use and are not part of the project.
/report.md
/report.html
/validation.html
/validation.svg
out/

# Reviewer notes and working documents. These are commentary ON this project,
# not part of it, and several name files outside the repository.
review_temp
*-review-handoff.md
